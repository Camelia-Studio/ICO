<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block page_title %}ICO{% endblock %}</title>
    <link rel="icon" type="image/png" href="{{ favicon_file }}">
    <link rel="stylesheet" href="css/base.css">
    <link rel="stylesheet" href="css/nav.css">
    <link rel="stylesheet" href="css/admin-layout.css">
    <link rel="stylesheet" href="css/admin-buttons.css">
    <link rel="stylesheet" href="css/admin-menu.css">
    <link rel="stylesheet" href="css/admin-forms.css">
    <link rel="stylesheet" href="css/admin-tree.css">
    <link rel="stylesheet" href="css/admin-data.css">
    <link rel="stylesheet" href="css/admin-modal.css">
    <link rel="stylesheet" href="css/admin-shares.css">
    {% for css in extraCss|default([]) %}
    <link rel="stylesheet" href="{{ css }}">
    {% endfor %}
    {% block extra_head %}{% endblock %}
</head>
<body class="{{ bodyClass|default('admin-page') }}"{% if dataPage|default('') != '' %} data-page="{{ dataPage }}"{% endif %}>

{% block content %}{% endblock %}

<footer class="site-footer">
    {% if social_links|default([])|length > 0 %}
    <div class="social-links">
        {% for link in social_links %}
        <a href="{{ link.url }}" class="social-link" target="_blank" rel="noopener noreferrer">{{ link.label }}</a>
        {% endfor %}
    </div>
    {% endif %}
    <p class="footer-text">
        Site propulsé grâce à <a href="https://git.crystalyx.net/camelia-studio/ICO" target="_blank" class="footer-link">ICO</a>
        <span class="footer-version">version {{ version }}</span>
    </p>
</footer>
{% block scripts %}{% endblock %}
</body>
</html>
