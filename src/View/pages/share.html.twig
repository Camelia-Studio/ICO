{% extends 'layout/base-public.html.twig' %}

{% block page_title %}Image - {{ site_title }}{% endblock %}

{% block body_class %}page-partage{% endblock %}

{% block extra_head %}
    <meta property="og:type"        content="website">
    <meta property="og:url"         content="{{ absolute_page }}">
    <meta property="og:title"       content="{{ og_title }}">
    <meta property="og:description" content="{{ og_description }}">
    <meta property="og:image"       content="{{ absolute_image }}">
    <meta name="twitter:card"       content="summary_large_image">
    <meta name="twitter:image"      content="{{ absolute_image }}">
{% endblock %}

{% block content %}
    <button class="back-button">Retour</button>

    <div class="share-container">
        <div class="share-image">
            {% if is_video %}
                <video src="{{ image_url }}"
                       controls
                       playsinline
                       class="share-video">
                </video>
            {% else %}
                <img src="{{ image_url }}"
                     data-image-url="{{ image_url }}"
                     alt="Image partagée">
            {% endif %}
        </div>

        <div class="share-actions">
            {% if allow_share %}
            <button class="action-button" onclick="shareImage()">
                <svg xmlns="http://www.w3.org/2000/svg" class="icon" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
                    <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
                </svg>
                Partager
            </button>
            {% endif %}

            {% if not is_private_image %}
            <button class="action-button" onclick="embedImage()">
                <svg xmlns="http://www.w3.org/2000/svg" class="icon" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="16 18 22 12 16 6"></polyline>
                    <polyline points="8 6 2 12 8 18"></polyline>
                </svg>
                Intégrer
            </button>
            {% endif %}

            {% if allow_download %}
            <a href="{{ image_url }}"
               download="{{ filename }}"
               class="action-button">
                <svg xmlns="http://www.w3.org/2000/svg" class="icon" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                    <polyline points="7 10 12 15 17 10"></polyline>
                    <line x1="12" y1="15" x2="12" y2="3"></line>
                </svg>
                Télécharger
            </a>
            {% endif %}

            {% if allow_source and not is_video %}
            <a href="https://saucenao.com/search.php?url={{ image_url|url_encode }}"
               target="_blank"
               class="action-button">
                <svg xmlns="http://www.w3.org/2000/svg" class="icon" viewBox="0 0 24 24" width="24" height="24" fill="currentColor">
                    <path d="M11.625 16.5a1.875 1.875 0 1 0 0-3.75 1.875 1.875 0 0 0 0 3.75Z"></path>
                    <path fill-rule="evenodd" d="M5.625 1.5H9a3.75 3.75 0 0 1 3.75 3.75v1.875c0 1.036.84 1.875 1.875 1.875H16.5a3.75 3.75 0 0 1 3.75 3.75v7.875c0 1.035-.84 1.875-1.875 1.875H5.625a1.875 1.875 0 0 1-1.875-1.875V3.375c0-1.036.84-1.875 1.875-1.875Zm6 16.5c.66 0 1.277-.19 1.797-.518l1.048 1.048a.75.75 0 0 0 1.06-1.06l-1.047-1.048A3.375 3.375 0 1 0 11.625 18Z" clip-rule="evenodd"></path>
                    <path d="M14.25 5.25a5.23 5.23 0 0 0-1.279-3.434 9.768 9.768 0 0 1 6.963 6.963A5.23 5.23 0 0 0 16.5 7.5h-1.875a.375.375 0 0 1-.375-.375V5.25Z"></path>
                </svg>
                Source ?
            </a>
            {% endif %}
        </div>
    </div>
{% endblock %}

{% block scripts %}
    <script src="js/share.js"></script>
{% endblock %}
