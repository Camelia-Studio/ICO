{% extends 'layout/base-public.html.twig' %}

{% block page_title %}Image - {{ site_title }}{% endblock %}

{% block body_class %}share-page{% endblock %}

{% block extra_head %}
    <meta property="og:type"        content="website">
    <meta property="og:url"         content="{{ absolute_page }}">
    <meta property="og:title"       content="{{ og_title }}">
    <meta property="og:description" content="{{ og_description }}">
    <meta property="og:image"       content="{{ absolute_image }}">
    <meta name="twitter:card"       content="summary_large_image">
    <meta name="twitter:image"      content="{{ absolute_image }}">
{% endblock %}

{% block content %}
    <button class="back-button">Retour</button>

    <div class="share-container">
        <div class="share-image">
            <img src="{{ image_url }}"
                 data-image-url="{{ image_url }}"
                 alt="Image partagée">
        </div>

        <div class="share-actions">
            {% if allow_share %}
            <button class="action-button" onclick="shareImage()">
                <svg xmlns="http://www.w3.org/2000/svg" class="icon" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"></path>
                    <polyline points="16 6 12 2 8 6"></polyline>
                    <line x1="12" y1="2" x2="12" y2="15"></line>
                </svg>
                Partager
            </button>
            {% endif %}

            {% if not is_private_image %}
            <button class="action-button" onclick="embedImage()">
                <svg xmlns="http://www.w3.org/2000/svg" class="icon" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="16 18 22 12 16 6"></polyline>
                    <polyline points="8 6 2 12 8 18"></polyline>
                </svg>
                Intégrer
            </button>
            {% endif %}

            {% if allow_download %}
            <a href="{{ image_url }}"
               download="{{ filename }}"
               class="action-button">
                <svg xmlns="http://www.w3.org/2000/svg" class="icon" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                    <polyline points="7 10 12 15 17 10"></polyline>
                    <line x1="12" y1="15" x2="12" y2="3"></line>
                </svg>
                Télécharger
            </a>
            {% endif %}

            {% if allow_source %}
            <a href="https://saucenao.com/search.php?url={{ image_url|url_encode }}"
               target="_blank"
               class="action-button">
                <svg xmlns="http://www.w3.org/2000/svg" class="icon" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    <line x1="11" y1="8" x2="11" y2="14"></line>
                    <line x1="8" y1="11" x2="14" y2="11"></line>
                </svg>
                Source ?
            </a>
            {% endif %}
        </div>
    </div>
{% endblock %}

{% block scripts %}
    <script src="js/share.js"></script>
{% endblock %}
