{% extends 'layout/base.html.twig' %}

{% block page_title %}Connexion - ICO{% endblock %}

{% block content %}
    <a href="index.php" class="back-button">← Retour à l'accueil</a>
    <div class="admin-login">
        <h1>Connexion</h1>
        {% include 'partials/messages.html.twig' %}
        {% if error is not null %}
            <div class="error-message">{{ error }}</div>
        {% endif %}
        <form method="post" action="admin.php?action=login">
            <div class="form-group">
                <label for="username">Identifiant :</label>
                <input type="text" id="username" name="username" required>
            </div>
            <div class="form-group">
                <label for="password">Mot de passe :</label>
                <input type="password" id="password" name="password" required>
            </div>
            <button type="submit" class="action-button">Se connecter</button>
        </form>
        {% if vestikanEnabled %}
            <div class="admin-login-sso">
                <a href="admin.php?action=vestikan_login" class="action-button">Se connecter avec Vestikan</a>
            </div>
        {% endif %}
    </div>
{% endblock %}
