{% extends 'layout/base.html.twig' %}

{% set isEdit = page is not null %}
{% set pageTitle = isEdit ? 'Modifier la page' : 'Nouvelle page' %}

{% block page_title %}{{ pageTitle }} - {{ site_title }}{% endblock %}

{% block content %}
    <div class="admin-header">
        <h1>{{ pageTitle }}</h1>
        <div class="admin-actions">
            <a href="pages-info.php" class="action-button action-button-secondary">Retour</a>
        </div>
    </div>

    <div class="admin-content">
        {% if error_message != '' %}
            <div class="message error-message">{{ error_message }}</div>
        {% endif %}

        <form method="post" action="pages-info.php?action=save" class="form-container form-container-wide">
            {% if isEdit %}
            <input type="hidden" name="id" value="{{ page.id }}">
            {% endif %}

            <div class="form-group">
                <label for="title">Titre de la page :</label>
                <input type="text" id="title" name="title" required autofocus
                       value="{{ page.title|default('') }}"
                       oninput="syncSlug(this.value)">
            </div>

            <div class="form-group">
                <label for="slug">Slug (URL) :</label>
                <div style="display:flex; gap:.5rem; align-items:center;">
                    <input type="text" id="slug" name="slug" required
                           value="{{ page.slug|default('') }}"
                           pattern="[a-z0-9\-]+" title="Lettres minuscules, chiffres et tirets uniquement"
                           style="flex:1;">
                    <button type="button" class="action-button action-button-secondary"
                            onclick="document.getElementById('slug').value = generateSlug(document.getElementById('title').value);"
                            title="Regénérer depuis le titre">↺</button>
                </div>
                <small class="form-help">Identifiant dans l'URL : <code>page.php?slug=<span id="slug-preview">{{ page.slug|default('mon-slug') }}</span></code></small>
            </div>

            <div class="form-group">
                <label for="content">Contenu (Markdown) :</label>
                <div class="markdown-editor">
                    <textarea id="content" name="content" rows="18"
                              class="form-textarea" style="font-family: monospace; font-size: .9rem;">{{ page.content|default('') }}</textarea>
                    <div id="content-preview" class="markdown-preview"></div>
                </div>
                <small class="form-help">Le contenu est écrit en Markdown ; l'aperçu à droite reflète le rendu réel sur la page publique.</small>
            </div>

            <div class="form-group">
                <label class="checkbox-label">
                    <input type="checkbox" name="is_published" value="1"
                           {{ (not isEdit or page.is_published) ? 'checked' : '' }}>
                    Page publiée (visible par les visiteurs)
                </label>
            </div>

            {% if isEdit and albums is not null %}
            <div class="form-group">
                <label>Albums liés à cette page :</label>
                {% if albums is empty %}
                    <p class="form-help">Aucun album disponible (les albums doivent contenir des images).</p>
                {% else %}
                    <div class="albums-checklist">
                        {% for album in albums %}
                        <label class="checkbox-label albums-checklist-item{{ album.other_link ? ' albums-checklist-item--other-link' : '' }}">
                            <input type="checkbox" name="album_links[]" value="{{ album.rel_path }}"
                                   {{ album.linked ? 'checked' : '' }}>
                            <span>{{ album.title }}</span>
                            {% if album.other_link %}
                                <small class="form-help"> (lien actuel : {{ album.more_info_url }})</small>
                            {% endif %}
                        </label>
                        {% endfor %}
                    </div>
                    <small class="form-help">Les albums cochés afficheront un bouton "En savoir plus" pointant vers cette page.</small>
                {% endif %}
            </div>
            {% endif %}

            <div class="form-actions">
                <button type="submit" class="action-button">
                    {{ isEdit ? 'Enregistrer les modifications' : 'Créer la page' }}
                </button>
            </div>
        </form>
    </div>
{% endblock %}

{% block scripts %}
    <script>
    function generateSlug(title) {
        const map = {
            'à':'a','â':'a','ä':'a','é':'e','è':'e','ê':'e','ë':'e',
            'î':'i','ï':'i','ô':'o','ö':'o','ù':'u','û':'u','ü':'u',
            'ç':'c','ñ':'n'
        };
        return title.toLowerCase()
            .replace(/[àâäéèêëîïôöùûüçñ]/g, c => map[c] || c)
            .replace(/[^a-z0-9]+/g, '-')
            .replace(/^-+|-+$/g, '');
    }

    let slugEdited = {{ isEdit|json_encode }};

    document.getElementById('slug').addEventListener('input', () => { slugEdited = true; });

    function syncSlug(title) {
        if (slugEdited) {
            document.getElementById('slug-preview').textContent = document.getElementById('slug').value || 'mon-slug';
            return;
        }
        const slug = generateSlug(title);
        document.getElementById('slug').value = slug;
        document.getElementById('slug-preview').textContent = slug || 'mon-slug';
    }

    document.getElementById('slug').addEventListener('input', function() {
        document.getElementById('slug-preview').textContent = this.value || 'mon-slug';
    });

    let previewTimer = null;
    const contentField   = document.getElementById('content');
    const previewContainer = document.getElementById('content-preview');

    function refreshPreview() {
        const body = new URLSearchParams({ content: contentField.value });
        fetch('pages-info.php?action=preview', { method: 'POST', body: body })
            .then(response => response.text())
            .then(html => { previewContainer.innerHTML = html; })
            .catch(() => {});
    }

    contentField.addEventListener('input', function () {
        clearTimeout(previewTimer);
        previewTimer = setTimeout(refreshPreview, 300);
    });

    refreshPreview();
    </script>
{% endblock %}
