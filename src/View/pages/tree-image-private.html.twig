{% extends 'layout/base.html.twig' %}

{% block page_title %}Gestion des images privées - {{ siteTitle }}{% endblock %}

{% block content %}
    {% include 'partials/breadcrumb.html.twig' with {'breadcrumbs': breadcrumbs} %}

    <div class="admin-header">
        <h1>
            Images de : {{ albumInfo.title }}
            <span class="private-badge">Privé</span>
            <span class="image-count-total">{{ imageData|length }} média{{ imageData|length != 1 ? 's' : '' }}</span>
        </h1>
        <div class="admin-actions">
            <button onclick="document.getElementById('imageUploadForm').click()" class="action-button action-button-success">
                Ajouter des médias
            </button>
            <button onclick="deleteSelected()" id="deleteSelectedBtn" class="action-button action-button-danger" style="display:none">
                Supprimer la sélection
            </button>
            <button onclick="toggleSelectAll()" id="selectAllBtn" class="action-button">
                Tout sélectionner
            </button>
            <a href="{{ backUrl }}" class="action-button action-button-secondary">
                Retour
            </a>
        </div>
    </div>

    <div class="admin-content">
        {% include 'partials/messages.html.twig' with {'nlBr': true} %}

        <div class="upload-zone" id="dropZone">
            <p>Glissez-déposez vos images ou vidéos ici ou cliquez sur "Ajouter des médias"</p>
            <form method="post" enctype="multipart/form-data" id="uploadForm">
                <input type="hidden" name="action" value="upload">
                <input type="file" name="images[]" id="imageUploadForm" multiple accept=".jpg,.jpeg,.png,.gif,.mp4,.webm">
            </form>
        </div>

        <form method="post" id="imagesForm">
            <input type="hidden" name="action" id="formAction" value="">
            <div class="images-grid">
                {% for item in imageData %}
                    <div class="image-item">
                        <input type="checkbox" name="images[]" value="{{ item.name }}"
                               class="image-checkbox" onchange="updateActionButtons()">
                        <div class="image-wrapper">
                            <a href="{{ item.shareUrl }}" target="_blank" class="image-share-link">
                                {% if item.type == 'video' %}
                                    <video src="{{ item.url }}" muted preload="none" class="admin-video-thumb"></video>
                                {% else %}
                                    <img src="{{ item.url }}" alt="{{ item.name }}" loading="lazy">
                                {% endif %}
                            </a>
                            <div class="image-actions">
                                <button type="button" onclick="toggleTop('{{ item.name|e('js') }}')"
                                    class="tree-button {{ item.isTop ? 'tree-button-top' : '' }}"
                                    title="{{ item.isTop ? 'Retirer des tops' : 'Mettre en top' }}">
                                    ⭐
                                </button>
                                <button type="button" onclick="deleteImage('{{ item.name|e('js') }}')"
                                    class="tree-button tree-button-danger">🗑️</button>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </form>
    </div>

    <!-- Modale de confirmation de suppression d'image -->
    <div id="deleteImageModal" class="modal">
        <div class="modal-content">
            <h2>Confirmer la suppression</h2>
            <p>Êtes-vous sûr de vouloir supprimer cette image ?</p>
            <div class="form-actions">
                <button type="button" onclick="closeImageModal()" class="action-button action-button-secondary">Annuler</button>
                <button type="button" onclick="confirmDeleteImage()" class="action-button action-button-danger">Supprimer</button>
            </div>
        </div>
    </div>

    <!-- Modale de téléversement -->
    <div id="uploadModal" class="modal-upload">
        <div class="modal-content">
            <div class="spinner"></div>
            <p>Téléversement en cours... veuillez patienter...</p>
        </div>
    </div>

    <button class="scroll-top" title="Retour en haut">↑</button>
{% endblock %}

{% block scripts %}
    <script src="js/tree-image.js"></script>
    <script src="js/scroll-top.js"></script>
{% endblock %}
