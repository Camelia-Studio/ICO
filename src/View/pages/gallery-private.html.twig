{% extends 'layout/base-public.html.twig' %}

{% block page_title %}{{ album_data is not null ? album_data.title : error_title }} - {{ site_title }}{% endblock %}

{% block body_class %}gallery-page{{ (album_data is not null and album_data.mature_content) ? ' gallery-page-mature content-blurred' : '' }}{% endblock %}

{% block extra_head %}
    <link rel="stylesheet" href="css/lightbox.css">
{% endblock %}

{% block content %}
    {% if error_title is not null %}
    <div class="error-container">
        <div class="error-content">
            <h1>{{ error_title }}</h1>
            <p>{{ error_message }}</p>
            <a href="index.php" class="action-button">Retour à l'accueil</a>
        </div>
    </div>

    {% else %}
    {% if album_data.mature_content %}
    <div id="mature-warning" class="mature-overlay">
        <div class="mature-content">
            <div class="mature-icon">🔞</div>
            <h2>Cet album contient du contenu réservé à un public averti.</h2>
            <button onclick="acceptMatureContent()" class="mature-button">J'ai plus de 18 ans - Afficher le contenu</button>
        </div>
    </div>
    {% endif %}

    {% include 'partials/breadcrumb.html.twig' with {'breadcrumbs': breadcrumbs} %}

    <div class="private-gallery-badge">
        <span class="private-icon">🔒</span> Album privé
    </div>

    {% if header_image is not null %}
    <div class="gallery-header">
        <img src="{{ header_image }}" alt="Image principale" class="header-image">
    </div>
    {% endif %}

    <div class="gallery-info">
        <h1>{{ album_data.title }}</h1>
        {% if album_data.description is not empty %}
        <p>{{ album_data.description|nl2br }}</p>
        {% endif %}
        {% if album_data.mature_content %}
        <div class="mature-badge">
            <span class="mature-badge-icon">🔞</span>
            Contenu réservé aux plus de 18 ans
        </div>
        {% endif %}
        <div class="album-actions">
            {% if album_data.more_info_url is not empty %}
            <div class="more-info-button">
                <a href="{{ album_data.more_info_url }}"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="action-button">
                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"/>
                        <line x1="12" y1="16" x2="12" y2="12"/>
                        <line x1="12" y1="8" x2="12" y2="8"/>
                    </svg>
                    En savoir plus sur {{ album_data.title }}
                </a>
            </div>
            {% endif %}
            {% if album_data.zip_download %}
            <div class="zip-download-button">
                <a href="{{ zip_url }}" class="action-button" download>
                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                        <polyline points="7 10 12 15 17 10"/>
                        <line x1="12" y1="15" x2="12" y2="3"/>
                    </svg>
                    Télécharger l'album en ZIP
                </a>
            </div>
            {% endif %}
        </div>
    </div>

    <div class="gallery-grid">
        {% for image in images %}
        {% set spanClass = '' %}
        {% if image.aspect_ratio > 1.7 %}
            {% set spanClass = 'gallery-item-wide' %}
        {% elseif image.aspect_ratio < 0.7 %}
            {% set spanClass = 'gallery-item-tall' %}
        {% endif %}
        <div class="gallery-item {{ image.is_top ? 'gallery-item-top' : '' }} {{ spanClass }}">
            {% if image.type == 'video' %}
                <div class="gallery-lightbox-trigger gallery-video-trigger"
                     data-type="video"
                     data-src="{{ image.url }}"
                     data-mime="{{ image.mime }}"
                     data-download-name="{{ image.filename }}"
                     {% if image.share_url %}data-share-url="{{ image.share_url }}"{% endif %}>
                    <video muted preload="none" class="gallery-video gallery-video-thumb">
                        <source src="{{ image.url }}" type="{{ image.mime }}">
                    </video>
                    <div class="gallery-video-play-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                            <polygon points="5 3 19 12 5 21 5 3"/>
                        </svg>
                    </div>
                </div>
            {% else %}
                <a href="{{ image.share_url }}"
                   class="gallery-lightbox-trigger"
                   data-type="image"
                   data-src="{{ image.url }}"
                   data-download-name="{{ image.filename }}"
                   {% if image.share_url %}data-share-url="{{ image.share_url }}"{% endif %}
                   target="_blank">
                    <img src="{{ image.url }}"
                         alt="Image de la galerie"
                         loading="lazy">
                </a>
            {% endif %}
        </div>
        {% endfor %}
    </div>

    {% if error_title is null %}
    {% include 'partials/lightbox.html.twig' with {
        'slideshow_interval': slideshow_interval,
        'allow_download': allow_download,
        'allow_share': allow_share,
        'allow_source': allow_source
    } only %}
    {% endif %}

    {% endif %}
    <button class="scroll-top" title="Retour en haut">↑</button>
{% endblock %}

{% block scripts %}
    <script src="js/gallery.js"></script>
    <script src="js/scroll-top.js"></script>
    <script src="js/lightbox.js"></script>
{% endblock %}
