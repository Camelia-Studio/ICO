{% extends 'layout/base.html.twig' %}

{% block page_title %}Personnalisation - {{ site_title }}{% endblock %}

{% block content %}
    <div class="admin-header">
        <h1>Personnalisation du site</h1>
        <div class="admin-actions">
            <a href="admin.php" class="action-button action-button-secondary">Retour</a>
        </div>
    </div>

    <div class="admin-content">
        {% if success_message != '' %}
            <div class="message success-message">{{ success_message }}</div>
        {% endif %}
        {% if error_message != '' %}
            <div class="message error-message">{{ error_message }}</div>
        {% endif %}

        <form method="post" action="personnalisation.php" class="form-container" enctype="multipart/form-data">
            <div class="form-group">
                <label for="site_title">Titre du site :</label>
                <input type="text" id="site_title" name="site_title" required
                       value="{{ site_title }}">
                <small class="form-help">Ce titre apparaîtra dans l'en-tête des pages et la barre de titre du navigateur.</small>
            </div>
            <div class="form-group">
                <label for="site_description">Description du site :</label>
                <textarea id="site_description" name="site_description" rows="4"
                          class="form-textarea">{{ site_description }}</textarea>
                <small class="form-help">Cette description apparaît sur la page d'accueil du site.</small>
            </div>
            <div class="form-group">
                <label for="project_path">Chemin d'installation :</label>
                <input type="text" id="project_path" name="project_path"
                       value="{{ project_path }}"
                       placeholder="Laisser vide si ICO est à la racine du domaine">
                <small class="form-help">Sous-chemin d'installation. Laisser vide si ICO est accessible directement via "www.monsite.com".
                    Sinon, indiquer le sous-chemin : par exemple "ico" si l'URL est "www.monsite.com/ico".</small>
            </div>

            <div class="form-group">
                <label for="favicon">Favicon du site :</label>
                <div class="favicon-preview">
                    <img src="{{ favicon_file }}" alt="Favicon actuel" width="32" height="32">
                    <span class="form-help">Favicon actuel</span>
                </div>
                <input type="file" id="favicon" name="favicon" accept="image/png">
                <small class="form-help">Image PNG uniquement, 1 Mo maximum. Laisser vide pour conserver le favicon actuel.</small>
                {% if has_custom_favicon %}
                <form method="post" action="personnalisation.php" style="display:inline;">
                    <input type="hidden" name="action" value="reset_favicon">
                    <button type="submit" class="action-button action-button-secondary">Remettre le favicon par défaut</button>
                </form>
                {% endif %}
            </div>

            <div class="form-actions">
                <button type="submit" class="action-button">Enregistrer les modifications</button>
            </div>
        </form>
    </div>
{% endblock %}
