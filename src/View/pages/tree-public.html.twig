{% extends 'layout/base.html.twig' %}

{% block page_title %}Arborescence - {{ siteTitle }}{% endblock %}

{% block content %}
    <div class="admin-header">
        <h1>Gestion de l'arborescence</h1>
        <div class="admin-actions">
            <button onclick="createSubfolder('./liste_albums')" class="action-button">Nouveau dossier</button>
            <a href="admin.php" class="action-button action-button-secondary">Retour</a>
        </div>
    </div>

    <div class="admin-content">
        {% include 'partials/messages.html.twig' %}

        <div class="tree-container">
            {{ tree|raw }}
        </div>
    </div>

    <!-- Modal de création de dossier -->
    <div id="createFolderModal" class="modal">
        <div class="modal-content">
            <h2>Créer un nouveau dossier</h2>
            <form method="post" action="arbre.php">
                <input type="hidden" name="action" value="create_folder">
                <input type="hidden" name="path" id="parentPath">
                <div class="form-group">
                    <label for="new_name">Nom du dossier :</label>
                    <input type="text" id="new_name" name="new_name" required>
                </div>
                <div class="form-group">
                    <label for="description">Description :</label>
                    <textarea id="description" name="description" rows="4" class="form-textarea"></textarea>
                </div>
                <div class="form-group">
                    <label>Lien "En savoir plus" (optionnel) :</label>
                    <div class="link-type-toggle">
                        <label><input type="radio" name="create_link_type" value="external" checked onchange="toggleLinkType('create')"> Lien externe</label>
                        {% if info_pages is not empty %}
                        <label><input type="radio" name="create_link_type" value="page" onchange="toggleLinkType('create')"> Page du site</label>
                        {% endif %}
                    </div>
                    <div id="create_link_external">
                        <input type="url" id="more_info_url" name="more_info_url" placeholder="https://...">
                    </div>
                    {% if info_pages is not empty %}
                    <div id="create_link_page" style="display:none">
                        <select id="create_page_select" name="more_info_url" class="form-select">
                            <option value="">— Choisir une page —</option>
                            {% for p in info_pages %}
                            <option value="page.php?slug={{ p.slug }}">{{ p.title }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    {% endif %}
                </div>
                <div class="form-group">
                    <label class="toggle-label">
                        <input type="checkbox" name="mature_content" id="mature_content">
                        <span class="toggle-text">Contenu réservé aux plus de 18 ans</span>
                        <span class="toggle-warning">⚠️</span>
                    </label>
                </div>
                <div class="form-group">
                    <label class="form-label">Options de la page de partage :</label>
                    <div class="share-options">
                        <label class="toggle-label">
                            <input type="checkbox" name="opt_share_download" id="create_share_download"
                                   {{ default_share_options.download ? 'checked' : '' }}>
                            <span class="toggle-text">Autoriser le téléchargement</span>
                        </label>
                        <label class="toggle-label">
                            <input type="checkbox" name="opt_share_source" id="create_share_source"
                                   {{ default_share_options.source ? 'checked' : '' }}>
                            <span class="toggle-text">Afficher le bouton "Source ?"</span>
                        </label>
                        <label class="toggle-label">
                            <input type="checkbox" name="opt_share_share" id="create_share_share"
                                   {{ default_share_options.share ? 'checked' : '' }}>
                            <span class="toggle-text">Afficher le bouton "Partager"</span>
                        </label>
                    </div>
                </div>
                <div class="form-actions">
                    <button type="button" onclick="closeModal()" class="action-button action-button-secondary">Annuler</button>
                    <button type="submit" class="action-button">Créer</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Modal d'édition de dossier -->
    <div id="editFolderModal" class="modal">
        <div class="modal-content">
            <h2>Modifier le dossier</h2>
            <form method="post" action="arbre.php">
                <input type="hidden" name="action" value="edit_folder">
                <input type="hidden" name="path" id="editPath">
                <div class="form-group">
                    <label for="edit_name">Nom du dossier :</label>
                    <input type="text" id="edit_name" name="new_name" required>
                </div>
                <div class="form-group">
                    <label for="edit_description">Description :</label>
                    <textarea id="edit_description" name="description" rows="4" class="form-textarea"></textarea>
                </div>
                <div class="form-group">
                    <label class="toggle-label">
                        <input type="checkbox" name="mature_content" id="edit_mature_content">
                        <span class="toggle-text">Contenu réservé aux plus de 18 ans</span>
                        <span class="toggle-warning">⚠️</span>
                    </label>
                </div>
                <div class="form-group" id="edit_more_info_url_field">
                    <label>Lien "En savoir plus" (optionnel) :</label>
                    <div class="link-type-toggle">
                        <label><input type="radio" name="edit_link_type" id="edit_link_type_external" value="external" checked onchange="toggleLinkType('edit')"> Lien externe</label>
                        {% if info_pages is not empty %}
                        <label><input type="radio" name="edit_link_type" id="edit_link_type_page" value="page" onchange="toggleLinkType('edit')"> Page du site</label>
                        {% endif %}
                    </div>
                    <div id="edit_link_external">
                        <input type="url" id="edit_more_info_url" name="more_info_url" placeholder="https://...">
                    </div>
                    {% if info_pages is not empty %}
                    <div id="edit_link_page" style="display:none">
                        <select id="edit_page_select" name="more_info_url" class="form-select">
                            <option value="">— Choisir une page —</option>
                            {% for p in info_pages %}
                            <option value="page.php?slug={{ p.slug }}">{{ p.title }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    {% endif %}
                </div>
                <div class="form-group" id="edit_zip_download_field" style="display:none">
                    <label class="toggle-label">
                        <input type="checkbox" name="zip_download" id="edit_zip_download">
                        <span class="toggle-text">Autoriser le téléchargement en ZIP</span>
                    </label>
                </div>
                <div class="form-group" id="edit_share_options_field" style="display:none">
                    <label class="form-label">Options de la page de partage :</label>
                    <div class="share-options">
                        <label class="toggle-label">
                            <input type="checkbox" name="opt_share_download" id="edit_share_download">
                            <span class="toggle-text">Autoriser le téléchargement</span>
                        </label>
                        <label class="toggle-label">
                            <input type="checkbox" name="opt_share_source" id="edit_share_source">
                            <span class="toggle-text">Afficher le bouton "Source ?"</span>
                        </label>
                        <label class="toggle-label">
                            <input type="checkbox" name="opt_share_share" id="edit_share_share">
                            <span class="toggle-text">Afficher le bouton "Partager"</span>
                        </label>
                    </div>
                </div>
                <div class="form-actions">
                    <button type="button" onclick="closeModal()" class="action-button action-button-secondary">Annuler</button>
                    <button type="submit" class="action-button">Enregistrer</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Modal de confirmation de suppression -->
    <div id="deleteFolderModal" class="modal">
        <div class="modal-content">
            <h2>Confirmer la suppression</h2>
            <p>Êtes-vous sûr de vouloir supprimer le dossier <strong id="deleteFolderName"></strong> et tout son contenu ?</p>
            <form method="post" action="arbre.php">
                <input type="hidden" name="action" value="delete_folder">
                <input type="hidden" name="path" id="deletePath">
                <div class="form-actions">
                    <button type="button" onclick="closeModal()" class="action-button action-button-secondary">Annuler</button>
                    <button type="submit" class="action-button action-button-danger">Supprimer</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Modal de déplacement de dossier -->
    <div id="moveFolderModal" class="modal">
        <div class="modal-content">
            <h2>Déplacer le dossier</h2>
            <p>Déplacer <strong id="moveFolderName"></strong> vers :</p>
            <form method="post" action="arbre.php">
                <input type="hidden" name="action" value="move_folder">
                <input type="hidden" name="path" id="movePath">
                <div class="form-group">
                    <label for="move_dest">Dossier de destination :</label>
                    <select id="move_dest" name="dest_path" class="form-select" required></select>
                </div>
                <div class="form-actions">
                    <button type="button" onclick="closeModal()" class="action-button action-button-secondary">Annuler</button>
                    <button type="submit" class="action-button">Déplacer</button>
                </div>
            </form>
        </div>
    </div>

    <button class="scroll-top" title="Retour en haut">↑</button>
{% endblock %}

{% block scripts %}
    <script>const allFolders = {{ allFoldersJson|raw }};</script>
    <script src="js/tree.js"></script>
    <script src="js/scroll-top.js"></script>
{% endblock %}
