{
    "name": "camelia-studio/ico",
    "description": "ICO — Galerie d'images auto-hébergée",
    "type": "project",
    "license": "proprietary",
    "homepage": "https://git.crystalyx.net/camelia-studio/ICO",
    "support": {
        "source": "https://git.crystalyx.net/camelia-studio/ICO"
    },
    "require": {
        "php": "^8.3",
        "symfony/dependency-injection": "7.4.*",
        "ext-pdo": "*",
        "ext-zip": "*",
        "twig/twig": "^3.11",
        "maennchen/zipstream-php": "^3.2",
        "league/commonmark": "^2.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "rector/rector": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "ICO\\": "src/"
        },
        "files": [
            "src/Vestikan/vestikan-sdk.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "ICO\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "platform": {
            "php": "8.3"
        }
    }
}
