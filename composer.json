{
    "name": "camelia-studio/ico",
    "description": "ICO — Galerie d'images auto-hébergée",
    "type": "project",
    "license": "proprietary",
    "homepage": "https://git.crystalyx.net/camelia-studio/ICO",
    "support": {
        "source": "https://git.crystalyx.net/camelia-studio/ICO"
    },
    "require": {
        "php": "^8.1",
        "symfony/dependency-injection": "^6.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "ICO\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ICO\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true
    }
}
